{"ledger_id": "401", "managed_id": "2809", "category_code": "401", "category_name": "史跡名勝天然記念物", "url": "https://kunishitei.bunka.go.jp/heritage/detail/401/2809", "name": "熊本城跡", "name_kana": "くまもとじょうあと", "types": ["特別史跡"], "designation_kind": "指定", "designated_date": "1933-02-28", "special_designated_date": "1955-12-29", "criteria": ["二．都城跡、国郡庁跡、城跡、官公庁、戦跡その他政治に関する遺跡"], "prefecture": "熊本県", "address": "熊本市本丸・二の丸・宮内・古城・古京町・千葉城町", "latitude": 32.8059906, "longitude": 130.70632284, "description": "南方に向って挺出した丘陵の広い尖端部とその裾を占めた平山城である。もと茶臼山と称した高所を中心とし、旧千葉城跡及び古城の地域等に亘り、加藤清正が慶長６年から同１２年に至るまで凡そ７年を費して築いた名城で、後ち細川氏この地に移封せられ、多少改修を施した。明治１０年西南の役陸軍少将谷干城これを死守し、天守閣等櫓楼多く焼失したが、なお宇土櫓をはじめ城門、櫓等よく遺存し、石垣及び堀等もまたよく旧観を保ち、近世における城郭の典型として価値が極めて高い。", "measures": [{"date": "1940-08-14", "types": ["追加指定"]}, {"date": "1952-11-22", "types": ["名称変更", "追加指定"]}, {"date": "1955-12-29", "types": ["特別史跡", "追加指定"]}, {"date": "1962-04-16", "types": ["一部解除"]}, {"date": "1983-03-31", "types": ["一部解除", "追加指定"]}, {"date": "2005-03-02", "types": ["追加指定"]}], "has_attachment": false, "has_measures": true, "has_photo": true}
